<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- 主程序叫 HoldDrag.App.exe：外层 HoldDrag.exe 是启动器（launcher/ 目录，net48），
         负责在缺 .NET 10 桌面运行时时给出中文提示。改名时 Updater.AssetName 与打包脚本要同步。 -->
    <AssemblyName>HoldDrag.App</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <!-- 明确"依赖 .NET 10，不打包运行时"：产物只有几百 KB，缺运行时时由启动器提示下载 -->
    <SelfContained>false</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>CS0168;CS0219;CS0649;CS8321;CA1416;CS0067;CS0414</NoWarn>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
</Project>
